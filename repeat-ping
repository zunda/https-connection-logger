#!/usr/bin/ruby
#
# Repeats requests to target URLs and prints metrics from curl command
#
# usage: INTERVAL=600 TARGETS=https://www.example.com/,https://www.example.org/ ./repeat-ping
#
# requires: curl command
#
require "json"
require "open3"
require "optparse"
require "time"

DEFAULT_INTERVAL = 600
DEFAULT_TARGETS = "https://clean-url.zunda.ninja/,https://zunda.ninja/"
USAGE = "Usage: #{File.basename(__FILE__)} [options], *:accepts env var"

interval = nil
targets_str = nil
OptionParser.new do |parser|
  parser.banner = USAGE

  parser.on("-i SECONDS", "--interval", "INTERVAL* between requests [#{DEFAULT_INTERVAL}]") do |x|
    interval = Float(x)
  end

  parser.on("-t URLs", "--targets", "TARGETS* [#{DEFAULT_TARGETS}]") do |x|
    targets_str = x
  end
end.parse!

interval ||= ENV["INTERVAL"]&.to_f || DEFAULT_INTERVAL
targets_str ||= ENV["TARGETS"] || DEFAULT_TARGETS
targets = targets_str.split(/,/)&.map{|u| u.strip}

write_out = %w(
  errormsg
  local_ip
  local_port
  remote_ip
  remote_port
  response_code
  time_appconnect
  time_connect
  time_namelookup
  time_pretransfer
  time_redirect
  time_starttransfer
  time_total
  url
)
write_out_arg = "%{stderr}" + write_out.map{"#{_1}\t%{#{_1}}\n"}.join()

x, _, s = Open3.capture3(*%w(curl -s https://4.ipaddr.io/ip))
src_ip = s.success? ? x : nil

cpids = targets.map do |target|
  Process.fork do
    while true
      started_at = Time.now
      _, stderr, _ = Open3.capture3("curl", "-s", "-w", write_out_arg, target)
      completed_at = Time.now
      data = stderr.split(/\n/).map{|x|
        name, val = x.split(/\t/)
        val ||= ""
        [name, val]
      }.to_h
      data["src_ip"] = src_ip if src_ip
      data["started_at"] = started_at.iso8601(3)
      data["completed_at"] = completed_at.iso8601(3)
      $stdout.puts data.to_json
      $stdout.flush
      sleep interval
    end
  end
end

cpid = Process.wait(0)
children = cpids.reject{|pid| pid == cpid}
Process.kill('SIGTERM', *children) unless children.empty?
Process.waitall
